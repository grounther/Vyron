-  const cutoff = new Date(Date.now() - olderThanHours * 60 * 60 * 1000).toISOString()
-
-  const { data, error } = await admin
-    .from('orders')
-    .delete()
-    .in('fulfillment_status', ['cancelled', 'canceled'])
-    .lt('updated_at', cutoff)
